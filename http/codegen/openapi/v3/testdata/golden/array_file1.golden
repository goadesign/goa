openapi: 3.1.1
info:
    title: Goa API
    version: 0.0.1
jsonSchemaDialect: https://json-schema.org/draft/2020-12/schema
servers:
    - url: https://goa.design
paths:
    /:
        post:
            tags:
                - testService
            summary: testEndpoint testService
            operationId: testService#testEndpoint
            requestBody:
                required: true
                content:
                    application/json:
                        schema:
                            type: array
                            items:
                                $ref: '#/components/schemas/Foobar'
                            examples:
                                - - bar:
                                        - string: ""
                                    foo: []
                                  - bar:
                                        - string: ""
                                    foo: []
                                  - bar:
                                        - string: ""
                                    foo: []
                        example:
                            - bar:
                                - string: ""
                              foo: []
                            - bar:
                                - string: ""
                              foo: []
                            - bar:
                                - string: ""
                              foo: []
                            - bar:
                                - string: ""
                              foo: []
            responses:
                "200":
                    description: OK response.
                    content:
                        application/json:
                            schema:
                                type: string
                                examples:
                                    - ""
                                minLength: 0
                                maxLength: 42
                            example: ""
components:
    schemas:
        Bar:
            type: object
            properties:
                string:
                    type: string
                    examples:
                        - ""
                    minLength: 0
                    maxLength: 42
            examples:
                - string: ""
        Foobar:
            type: object
            properties:
                bar:
                    type: array
                    items:
                        $ref: '#/components/schemas/Bar'
                    examples:
                        - - string: ""
                          - string: ""
                    minItems: 0
                    maxItems: 42
                foo:
                    type: array
                    items:
                        type: string
                        examples:
                            - Beatae non id consequatur.
                    examples:
                        - []
                    minItems: 0
                    maxItems: 42
            examples:
                - bar:
                    - string: ""
                    - string: ""
                  foo:
                    - Repudiandae sit.
                    - Asperiores fuga qui rem qui earum eos.
tags:
    - name: testService
