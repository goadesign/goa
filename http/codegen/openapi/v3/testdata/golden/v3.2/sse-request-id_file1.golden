openapi: 3.2.0
info:
    title: Goa API
    version: 0.0.1
servers:
    - url: http://localhost:80
      name: test api
      description: Default server for test api
paths:
    /request-id:
        get:
            tags:
                - SSERequestIDService
            summary: SSERequestIDMethod SSERequestIDService
            operationId: SSERequestIDService#SSERequestIDMethod
            parameters:
                - name: Last-Event-ID
                  in: header
                  schema:
                    type: string
                    example: request
                  example: request
            responses:
                "200":
                    description: OK response.
                    content:
                        text/event-stream:
                            itemSchema:
                                type: object
                                properties:
                                    data:
                                        type: string
                                        example: event
                                required:
                                    - data
components: {}
tags:
    - name: SSERequestIDService
