openapi: 3.2.0
info:
    title: Goa API
    version: 0.0.1
servers:
    - url: http://localhost:80
      name: test api
      description: Default server for test api
paths:
    /object:
        get:
            tags:
                - SSEObjectService
            summary: SSEObjectMethod SSEObjectService
            operationId: SSEObjectService#SSEObjectMethod
            responses:
                "200":
                    description: OK response.
                    content:
                        text/event-stream:
                            itemSchema:
                                type: object
                                properties:
                                    data:
                                        type: string
                                        contentMediaType: application/json
                                        contentSchema:
                                            type: object
                                            properties:
                                                flag:
                                                    type: boolean
                                                    example: true
                                                id:
                                                    type: string
                                                    example: Ipsa sed perferendis rerum.
                                                value:
                                                    type: integer
                                                    example: 5784889851462556968
                                                    format: int64
                                            example:
                                                flag: true
                                                id: Ipsa sed perferendis rerum.
                                                value: 5784889851462556968
                                required:
                                    - data
components:
    schemas:
        SSEObjectMethodResponseBody:
            type: object
            properties:
                flag:
                    type: boolean
                    example: true
                id:
                    type: string
                    example: Aut non.
                value:
                    type: integer
                    example: 8434029765132757469
                    format: int64
            example:
                flag: true
                id: Aut non.
                value: 8434029765132757469
tags:
    - name: SSEObjectService
