openapi: 3.2.0
info:
    title: Goa API
    version: 0.0.1
servers:
    - url: http://localhost:80
      name: test api
      description: Default server for test api
paths:
    /data-field:
        get:
            tags:
                - SSEDataFieldService
            summary: SSEDataFieldMethod SSEDataFieldService
            operationId: SSEDataFieldService#SSEDataFieldMethod
            responses:
                "200":
                    description: OK response.
                    content:
                        text/event-stream:
                            itemSchema:
                                type: object
                                properties:
                                    data:
                                        type: string
                                        example: Sunt itaque inventore optio quia ullam aut.
                                required:
                                    - data
components:
    schemas:
        SSEDataFieldMethodResponseBody:
            type: object
            properties:
                data:
                    type: string
                    example: Quia molestias.
                flag:
                    type: boolean
                    example: true
            example:
                data: Qui quia inventore et tempora.
                flag: true
tags:
    - name: SSEDataFieldService
