openapi: 3.2.0
info:
    title: Goa API
    version: 0.0.1
servers:
    - url: http://localhost:80
      name: test api
      description: Default server for test api
paths:
    /{x}:
        get:
            tags:
                - StreamingResultService
            summary: StreamingResultMethod StreamingResultService
            operationId: StreamingResultService#StreamingResultMethod
            parameters:
                - name: x
                  in: path
                  required: true
                  schema:
                    type: string
                    example: Doloribus qui quia.
                  example: Et tempora et quae.
            responses:
                "101":
                    description: Switching Protocols response.
                    content:
                        application/json:
                            schema:
                                $ref: '#/components/schemas/UserType'
                            example:
                                a: Odio laborum quae ut quis nostrum.
components:
    schemas:
        UserType:
            type: object
            properties:
                a:
                    type: string
                    example: Quia molestias.
            example:
                a: Magnam id itaque quo.
tags:
    - name: StreamingResultService
