openapi: 3.2.0
info:
    title: Goa API
    version: 0.0.1
servers:
    - url: http://localhost:80
      name: test api
      description: Default server for test api
paths:
    /all-fields:
        get:
            tags:
                - SSEAllFieldsService
            summary: SSEAllFieldsMethod SSEAllFieldsService
            operationId: SSEAllFieldsService#SSEAllFieldsMethod
            parameters:
                - name: Last-Event-ID
                  in: header
                  schema:
                    type: string
                    example: request
                  example: request
            responses:
                "200":
                    description: OK response.
                    content:
                        text/event-stream:
                            itemSchema:
                                type: object
                                properties:
                                    data:
                                        type: string
                                        contentMediaType: application/json
                                        contentSchema:
                                            type: object
                                            properties:
                                                message:
                                                    type: string
                                                    example: Hello, world!
                                            example:
                                                message: Hello, world!
                                    event:
                                        type: string
                                        example: update
                                    id:
                                        type: string
                                        example: "123"
                                    retry:
                                        type: integer
                                        example: 3000
                                        format: int64
components:
    schemas:
        SSEAllFieldsMethodResponseBody:
            type: object
            properties:
                data:
                    type: object
                    properties:
                        message:
                            type: string
                            example: Hello, world!
                    example:
                        message: Hello, world!
                event:
                    type: string
                    example: update
                id:
                    type: string
                    example: "123"
                retry:
                    type: integer
                    example: 3000
                    format: int64
            example:
                data:
                    message: Hello, world!
                event: update
                id: "123"
                retry: 3000
tags:
    - name: SSEAllFieldsService
