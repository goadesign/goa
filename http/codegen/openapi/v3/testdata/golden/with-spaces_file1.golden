openapi: 3.0.3
info:
    title: Goa API
    version: 0.0.1
servers:
    - url: http://localhost:80
      description: Default server for test api
paths:
    /:
        post:
            tags:
                - test service
            summary: test endpoint test service
            operationId: test service#test endpoint
            requestBody:
                description: Request body for test endpoint.
                required: true
                content:
                    application/json:
                        schema:
                            $ref: '#/components/schemas/Bar'
                        example:
                            string: item
            responses:
                "200":
                    description: OK response.
                    content:
                        application/json:
                            schema:
                                $ref: '#/components/schemas/GoaFoobar'
                            examples:
                                default:
                                    summary: default
                                    value:
                                        bar:
                                            - string: item
                                        foo: ""
                "404":
                    description: Not Found response.
                    content:
                        application/json:
                            schema:
                                $ref: '#/components/schemas/GoaFoobar'
                            examples:
                                default:
                                    summary: default
                                    value:
                                        bar:
                                            - string: item
components:
    schemas:
        Bar:
            type: object
            properties:
                string:
                    type: string
                    example: ""
            description: Request body for test endpoint.
            example:
                string: item
        GoaFoobar:
            type: object
            properties:
                bar:
                    type: array
                    items:
                        $ref: '#/components/schemas/Bar'
                    example:
                        - string: item
                foo:
                    type: string
                    example: ""
            example:
                bar:
                    - string: item
                foo: ""
tags:
    - name: test service
