      "get": {
        "operationId": "service-name#/path1",
        "responses": {
          "200": {
            "description": "File downloaded"
          }
        },
        "summary": "Download filename",
        "tags": [
          "service-name"
        ]
      }
    },
    "/path2": {
      "get": {
        "operationId": "service-name#/path2",
