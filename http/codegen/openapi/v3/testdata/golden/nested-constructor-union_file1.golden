openapi: 3.0.3
info:
    title: Goa API
    version: 0.0.1
servers:
    - url: http://localhost:80
      description: Default server for test api
paths:
    /:
        post:
            tags:
                - NestedConstructorUnion
            summary: Show NestedConstructorUnion
            operationId: NestedConstructorUnion#Show
            requestBody:
                required: true
                content:
                    application/json:
                        schema:
                            $ref: '#/components/schemas/NestedPayload'
                        example:
                            choice:
                                type: TextPayload
                                value:
                                    text: Qui molestiae iure.
            responses:
                "200":
                    description: OK response.
                    content:
                        application/json:
                            schema:
                                $ref: '#/components/schemas/NestedPayload'
                            example:
                                choice:
                                    type: TextPayload
                                    value:
                                        text: Aut ipsam provident aliquam tempora beatae.
components:
    schemas:
        JSONPayload:
            type: object
            properties:
                message:
                    type: string
                    example: Et tempora et quae.
            example:
                message: Itaque inventore optio.
            required:
                - message
        NestedPayload:
            type: object
            properties:
                choice:
                    discriminator:
                        mapping:
                            JSONPayload: '#/components/schemas/TextPayloadOrJSONPayloadJSONPayloadEnvelope1d1e27eb46f1e82c'
                            TextPayload: '#/components/schemas/TextPayloadOrJSONPayloadTextPayloadEnvelope80d6bc984d45350d'
                        propertyName: type
                    example:
                        type: TextPayload
                        value:
                            text: Neque nisi quibusdam nisi sint sunt.
                    oneOf:
                        - $ref: '#/components/schemas/TextPayloadOrJSONPayloadTextPayloadEnvelope80d6bc984d45350d'
                        - $ref: '#/components/schemas/TextPayloadOrJSONPayloadJSONPayloadEnvelope1d1e27eb46f1e82c'
                    properties:
                        type:
                            enum:
                                - TextPayload
                                - JSONPayload
                            type: string
                        value:
                            anyOf:
                                - $ref: '#/components/schemas/TextPayload'
                                - $ref: '#/components/schemas/JSONPayload'
                    required:
                        - type
                        - value
                    type: object
            example:
                choice:
                    type: TextPayload
                    value:
                        text: Neque nisi quibusdam nisi sint sunt.
            required:
                - choice
        TextPayload:
            type: object
            properties:
                text:
                    type: string
                    example: Quia molestias.
            example:
                text: Doloribus qui quia.
            required:
                - text
        TextPayloadOrJSONPayloadJSONPayloadEnvelope1d1e27eb46f1e82c:
            type: object
            properties:
                type:
                    type: string
                    enum:
                        - JSONPayload
                value:
                    $ref: '#/components/schemas/JSONPayload'
            required:
                - type
                - value
        TextPayloadOrJSONPayloadTextPayloadEnvelope80d6bc984d45350d:
            type: object
            properties:
                type:
                    type: string
                    enum:
                        - TextPayload
                value:
                    $ref: '#/components/schemas/TextPayload'
            required:
                - type
                - value
tags:
    - name: NestedConstructorUnion
