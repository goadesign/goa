            }
          },
          "500": {
            "description": "internal: Internal Server Error response.",
            "examples": {
              "application/vnd.goa.error": {
                "fault": true,
                "id": "123abc",
                "message": "parameter 'p' must be an integer",
                "name": "internal",
                "temporary": false,
                "timeout": false
              }
            },
            "schema": {
              "$ref": "#/definitions/ErrorsErrorInternalResponseBody"
            }
          },
          "503": {
