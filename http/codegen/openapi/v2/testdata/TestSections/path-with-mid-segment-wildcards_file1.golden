swagger: "2.0"
info:
    title: ""
    version: 0.0.1
host: localhost:80
consumes:
    - application/json
    - application/xml
    - application/gob
produces:
    - application/json
    - application/xml
    - application/gob
paths:
    /user/@{username}/{month}-{day}-{year}:
        post:
            tags:
                - test service
            summary: test endpoint test service
            operationId: test service#test endpoint
            parameters:
                - name: username
                  in: path
                  required: true
                  type: string
                - name: month
                  in: path
                  required: true
                  type: string
                - name: day
                  in: path
                  required: true
                  type: string
                - name: year
                  in: path
                  required: true
                  type: string
            responses:
                "204":
                    description: No Content response.
            schemes:
                - http
