swagger: "2.0"
info:
    title: ""
    version: 0.0.1
host: localhost:80
consumes:
    - application/json
    - application/xml
    - application/gob
produces:
    - application/json
    - application/xml
    - application/gob
paths:
    /builds:
        post:
            tags:
                - builds
            summary: start builds
            operationId: builds#start
            responses:
                "201":
                    description: Created response.
                    schema:
                        type: string
                "404":
                    description: |-
                        not_found: Project not found

                        gone: Project deleted
                    schema:
                        $ref: '#/definitions/BuildsStartNotFoundResponseBody'
                    examples:
                        application/vnd.goa.error:
                            fault: false
                            id: 123abc
                            message: parameter 'p' must be an integer
                            name: not_found
                            temporary: false
                            timeout: false
                "409":
                    description: |-
                        build_open: Another build is open

                        conflict: Request conflicts with the current state

                        quota_exceeded: Build quota reached
                    schema:
                        $ref: '#/definitions/BuildOpen'
                        required:
                            - name
                            - message
                            - build_id
                    headers:
                        X-Retry-After:
                            description: Seconds until a build slot frees up
                            type: integer
                            format: int64
                    examples:
                        application/vnd.goa.error:
                            fault: false
                            id: 123abc
                            message: parameter 'p' must be an integer
                            name: conflict
                            temporary: false
                            timeout: false
            schemes:
                - http
definitions:
    BuildOpen:
        title: BuildOpen
        type: object
        properties:
            build_id:
                type: string
                description: Open build
                example: b-17
            message:
                type: string
                description: Refusal reason
                example: another build is open
            name:
                type: string
                description: Error name
                example: Odit autem quia ullam delectus aut.
        description: BuildOpen reports the build that blocks a new one.
        example:
            build_id: b-17
            message: another build is open
            name: Odit autem quia ullam delectus aut.
        required:
            - name
            - message
            - build_id
    BuildsStartConflictResponseBody:
        title: 'Mediatype identifier: application/vnd.goa.error; view=default'
        type: object
        properties:
            fault:
                type: boolean
                description: Is the error a server-side fault?
                example: false
            id:
                type: string
                description: ID is a unique identifier for this particular occurrence of the problem.
                example: 123abc
            message:
                type: string
                description: Message is a human-readable explanation specific to this occurrence of the problem.
                example: parameter 'p' must be an integer
            name:
                type: string
                description: Name is the name of this class of errors.
                example: bad_request
            temporary:
                type: boolean
                description: Is the error temporary?
                example: false
            timeout:
                type: boolean
                description: Is the error a timeout?
                example: false
        description: Error response result type (default view)
        example:
            fault: false
            id: 123abc
            message: parameter 'p' must be an integer
            name: bad_request
            temporary: false
            timeout: false
        required:
            - name
            - id
            - message
            - temporary
            - timeout
            - fault
    BuildsStartGoneResponseBody:
        title: 'Mediatype identifier: application/vnd.goa.error; view=default'
        type: object
        properties:
            fault:
                type: boolean
                description: Is the error a server-side fault?
                example: false
            id:
                type: string
                description: ID is a unique identifier for this particular occurrence of the problem.
                example: 123abc
            message:
                type: string
                description: Message is a human-readable explanation specific to this occurrence of the problem.
                example: parameter 'p' must be an integer
            name:
                type: string
                description: Name is the name of this class of errors.
                example: bad_request
            temporary:
                type: boolean
                description: Is the error temporary?
                example: true
            timeout:
                type: boolean
                description: Is the error a timeout?
                example: false
        description: Error response result type (default view)
        example:
            fault: false
            id: 123abc
            message: parameter 'p' must be an integer
            name: bad_request
            temporary: true
            timeout: false
        required:
            - name
            - id
            - message
            - temporary
            - timeout
            - fault
    BuildsStartNotFoundResponseBody:
        title: 'Mediatype identifier: application/vnd.goa.error; view=default'
        type: object
        properties:
            fault:
                type: boolean
                description: Is the error a server-side fault?
                example: true
            id:
                type: string
                description: ID is a unique identifier for this particular occurrence of the problem.
                example: 123abc
            message:
                type: string
                description: Message is a human-readable explanation specific to this occurrence of the problem.
                example: parameter 'p' must be an integer
            name:
                type: string
                description: Name is the name of this class of errors.
                example: bad_request
            temporary:
                type: boolean
                description: Is the error temporary?
                example: true
            timeout:
                type: boolean
                description: Is the error a timeout?
                example: false
        description: Error response result type (default view)
        example:
            fault: true
            id: 123abc
            message: parameter 'p' must be an integer
            name: bad_request
            temporary: true
            timeout: false
        required:
            - name
            - id
            - message
            - temporary
            - timeout
            - fault
    QuotaExceeded:
        title: QuotaExceeded
        type: object
        properties:
            limit:
                type: integer
                description: Maximum number of builds
                example: 3
                format: int64
            name:
                type: string
                description: Error name
                example: Aut repellendus asperiores.
        description: QuotaExceeded reports the build quota that was reached.
        example:
            limit: 3
            name: Aut repellendus asperiores.
        required:
            - name
            - limit
