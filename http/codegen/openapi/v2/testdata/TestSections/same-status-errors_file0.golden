      "type": "object"
    },
    "QuotaExceeded": {
      "description": "QuotaExceeded reports the build quota that was reached.",
      "example": {
        "limit": 3,
        "name": "Aut repellendus asperiores."
      },
      "properties": {
        "limit": {
          "description": "Maximum number of builds",
          "example": 3,
          "format": "int64",
          "type": "integer"
        },
        "name": {
          "description": "Error name",
          "example": "Aut repellendus asperiores.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "limit"
      ],
      "title": "QuotaExceeded",
      "type": "object"
    }
  },
  "host": "localhost:80",
  "info": {
    "title": "",
    "version": "0.0.1"
  },
  "paths": {
    "/builds": {
      "post": {
        "operationId": "builds#start",
        "responses": {
          "201": {
            "description": "Created response.",
            "schema": {
              "type": "string"
            }
          },
          "404": {
            "description": "not_found: Project not found\n\ngone: Project deleted",
            "examples": {
              "application/vnd.goa.error": {
                "fault": false,
                "id": "123abc",
                "message": "parameter 'p' must be an integer",
                "name": "not_found",
                "temporary": false,
                "timeout": false
              }
            },
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/definitions/BuildsStartNotFoundResponseBody"
                },
                {
                  "$ref": "#/definitions/BuildsStartGoneResponseBody"
                }
              ]
            }
          },
          "409": {
            "description": "build_open: Another build is open\n\nconflict: Request conflicts with the current state\n\nquota_exceeded: Build quota reached",
            "examples": {
              "application/vnd.goa.error": {
                "fault": false,
                "id": "123abc",
                "message": "parameter 'p' must be an integer",
                "name": "conflict",
                "temporary": false,
                "timeout": false
              }
            },
            "headers": {
              "X-Retry-After": {
                "description": "Seconds until a build slot frees up",
                "format": "int64",
                "type": "integer"
              }
            },
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/definitions/BuildOpen",
                  "required": [
                    "name",
                    "message",
                    "build_id"
                  ]
                },
                {
                  "$ref": "#/definitions/BuildsStartConflictResponseBody"
                },
                {
                  "$ref": "#/definitions/QuotaExceeded",
                  "required": [
                    "name",
                    "limit"
                  ]
                }
              ]
            }
          }
        },
        "schemes": [
          "http"
        ],
        "summary": "start builds",
        "tags": [
          "builds"
        ]
      }
    }
  },
  "produces": [
    "application/json",
    "application/xml",
    "application/gob"
  ],
  "swagger": "2.0"
}
