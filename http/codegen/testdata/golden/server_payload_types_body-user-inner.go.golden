// NewMethodBodyUserInnerPayload builds a ServiceBodyUserInner service
// MethodBodyUserInner endpoint payload.
func NewMethodBodyUserInnerPayload(body *MethodBodyUserInnerRequestBody) *servicebodyuserinner.PayloadType {
	v := &servicebodyuserinner.PayloadType{}
	if body.Inner != nil {
		v.Inner = unmarshalInnerTypeToInnerType(body.Inner)
	}

	return v
}
