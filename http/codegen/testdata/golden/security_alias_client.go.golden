// EncodeBasicRequest returns an encoder for requests sent to the
// NamedSecurityTypes Basic server.
func EncodeBasicRequest(encoder func(*http.Request) goahttp.Encoder) func(*http.Request, any) error {
	return func(req *http.Request, v any) error {
		p, ok := v.(*namedsecuritytypes.BasicPayload)
		if !ok {
			return goahttp.ErrInvalidType("NamedSecurityTypes", "Basic", "*namedsecuritytypes.BasicPayload", v)
		}
		var pass string
		if p.Password != nil {
			pass = string(*p.Password)
		}
		req.SetBasicAuth(string(p.Username), pass)
		return nil
	}
}

// EncodeBasicOptionalRequest returns an encoder for requests sent to the
// NamedSecurityTypes BasicOptional server.
func EncodeBasicOptionalRequest(encoder func(*http.Request) goahttp.Encoder) func(*http.Request, any) error {
	return func(req *http.Request, v any) error {
		p, ok := v.(*namedsecuritytypes.BasicOptionalPayload)
		if !ok {
			return goahttp.ErrInvalidType("NamedSecurityTypes", "BasicOptional", "*namedsecuritytypes.BasicOptionalPayload", v)
		}
		var user string
		if p.Username != nil {
			user = string(*p.Username)
		}
		var pass string
		if p.Password != nil {
			pass = string(*p.Password)
		}
		if p.Username != nil || p.Password != nil {
			req.SetBasicAuth(user, pass)
		}
		return nil
	}
}

// EncodeAPIKeyRequest returns an encoder for requests sent to the
// NamedSecurityTypes APIKey server.
func EncodeAPIKeyRequest(encoder func(*http.Request) goahttp.Encoder) func(*http.Request, any) error {
	return func(req *http.Request, v any) error {
		p, ok := v.(*namedsecuritytypes.APIKeyPayload)
		if !ok {
			return goahttp.ErrInvalidType("NamedSecurityTypes", "APIKey", "*namedsecuritytypes.APIKeyPayload", v)
		}
		{
			head := p.Key
			req.Header.Set("X-API-Key", string(head))
		}
		return nil
	}
}

// EncodeBearerRequest returns an encoder for requests sent to the
// NamedSecurityTypes Bearer server.
func EncodeBearerRequest(encoder func(*http.Request) goahttp.Encoder) func(*http.Request, any) error {
	return func(req *http.Request, v any) error {
		p, ok := v.(*namedsecuritytypes.BearerPayload)
		if !ok {
			return goahttp.ErrInvalidType("NamedSecurityTypes", "Bearer", "*namedsecuritytypes.BearerPayload", v)
		}
		if p.Token != nil {
			head := *p.Token
			req.Header.Set("X-Bearer", string(head))
		}
		return nil
	}
}

