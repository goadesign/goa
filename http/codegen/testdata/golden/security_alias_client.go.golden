		}
		return nil
	}
}

// EncodeOAuth2Request returns an encoder for requests sent to the
// NamedSecurityTypes OAuth2 server.
func EncodeOAuth2Request(encoder func(*http.Request) goahttp.Encoder) func(*http.Request, any) error {
