// Validate ensures exactly one valid branch is selected.
func (u RelationshipResponseBody) Validate() error {
	switch u.kind {
	case "":
		return goa.InvalidEnumValueError("type", "", []any{
			string(RelationshipResponseBodyKindNone),
			string(RelationshipResponseBodyKindEditable),
		})
	case RelationshipResponseBodyKindNone:
		if u.none == nil {
			return goa.MissingFieldError("value", "RelationshipResponseBody")
		}
		return nil
	case RelationshipResponseBodyKindEditable:
		if u.editable == nil {
			return goa.MissingFieldError("value", "RelationshipResponseBody")
		}
		return nil
	default:
		return goa.InvalidEnumValueError("type", u.kind, []any{
			string(RelationshipResponseBodyKindNone),
			string(RelationshipResponseBodyKindEditable),
		})
	}
}

// MarshalJSON marshals the union into the canonical {type,value} JSON shape.
func (u RelationshipResponseBody) MarshalJSON() ([]byte, error) {
	if err := u.Validate(); err != nil {
		return nil, err
	}
	var (
		value any
	)
	switch u.kind {
	case RelationshipResponseBodyKindNone:
		value = u.none
	case RelationshipResponseBodyKindEditable:
		value = u.editable
	default:
		return nil, fmt.Errorf("unexpected RelationshipResponseBody kind %q", u.kind)
	}
	return json.Marshal(struct {
		Type  string `json:"type"`
		Value any    `json:"value"`
	}{
		Type:  string(u.kind),
		Value: value,
	})
}

// UnmarshalJSON unmarshals the union from the canonical {type,value} JSON shape.
func (u *RelationshipResponseBody) UnmarshalJSON(data []byte) error {
	var raw struct {
		Type  string          `json:"type"`
		Value json.RawMessage `json:"value"`
	}
	if err := json.Unmarshal(data, &raw); err != nil {
		return err
	}
	if len(raw.Value) == 0 {
		return goa.MissingFieldError("value", "RelationshipResponseBody")
	}
	if bytes.Equal(bytes.TrimSpace(raw.Value), []byte("null")) {
		return goa.InvalidFieldTypeError("value", nil, "non-null JSON value")
	}
	switch raw.Type {
	case string(RelationshipResponseBodyKindNone):
		var v *NoEditResponseBody
		if err := json.Unmarshal(raw.Value, &v); err != nil {
			return err
		}
		u.SetNone(v)
	case string(RelationshipResponseBodyKindEditable):
		var v *EditableResponseBody
		if err := json.Unmarshal(raw.Value, &v); err != nil {
			return err
		}
		u.SetEditable(v)
	default:
		if raw.Type == "" {
			return goa.MissingFieldError("type", "RelationshipResponseBody")
		}
		return goa.InvalidEnumValueError("type", raw.Type, []any{
			string(RelationshipResponseBodyKindNone),
			string(RelationshipResponseBodyKindEditable),
		})
	}
	return nil
}

