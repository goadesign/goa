	// RelationshipResponseBodyKindEditable identifies the editable branch.
	RelationshipResponseBodyKindEditable RelationshipResponseBodyKind = "editable"
)

// Kind returns the selected branch.
func (u RelationshipResponseBody) Kind() RelationshipResponseBodyKind {
	return u.kind
}

// NewRelationshipResponseBodyNone constructs RelationshipResponseBody with the none branch set.
