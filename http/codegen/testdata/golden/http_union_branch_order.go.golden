// RelationshipResponseBody holds exactly one of its branch values.
type RelationshipResponseBody struct {
	kind     RelationshipResponseBodyKind
	none     *NoEditResponseBody
	editable *EditableResponseBody
}

// RelationshipResponseBodyKind records which RelationshipResponseBody branch is selected.
type RelationshipResponseBodyKind string

const (
