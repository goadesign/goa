// ValidateChooseRequestBody2 runs the validations defined on ChooseRequestBody2
func ValidateChooseRequestBody2(body *ChooseRequestBody2) (err error) {
	if body.Value == nil {
		err = goa.MergeErrors(err, goa.MissingFieldError("value", "body"))
	}
	if body.Value != nil {
		if utf8.RuneCountInString(*body.Value) < 2 {
			err = goa.MergeErrors(err, goa.InvalidLengthError("body.value", *body.Value, utf8.RuneCountInString(*body.Value), 2, true))
		}
	}
	return
}

