func NewMethodEmptyErrorResponseBodyInternalError(name string, id string, message string, temporary bool, timeout bool, fault bool) *goa.ServiceError {
	v := &goa.ServiceError{}
	v.Name = name
	v.ID = id
	v.Message = message
	v.Temporary = temporary
	v.Timeout = timeout
