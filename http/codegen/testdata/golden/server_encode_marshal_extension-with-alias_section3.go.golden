// marshalFooserviceExtensionToExtension2 builds a value of type *Extension2
// from a value of type *fooservice.Extension.
func marshalFooserviceExtensionToExtension2(v *fooservice.Extension) *Extension2 {
	if v == nil {
		return nil
	}
	res := &Extension2{}
	if v.Bar != nil {
		res.Bar = marshalFooserviceBarToBar2(v.Bar)
	}

	return res
}
