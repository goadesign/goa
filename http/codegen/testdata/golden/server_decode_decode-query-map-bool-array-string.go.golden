									err = goa.MergeErrors(err, goa.InvalidFieldTypeError("query", keyaRaw, "boolean"))
								}
								keya = v
							}
						}
						q[keya] = valRaw
					}
				}
			}
		}
		if err != nil {
			return nil, err
		}
