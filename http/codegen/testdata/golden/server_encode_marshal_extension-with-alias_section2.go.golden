// marshalResultTypeToResultType builds a value of type *ResultType from a
// value of type *fooservice.ResultType.
func marshalResultTypeToResultType(v *fooservice.ResultType) *ResultType {
	res := &ResultType{}
	if v.Extension != nil {
		res.Extension = marshalExtensionToExtension(v.Extension)
	}

	return res
}
