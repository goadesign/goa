// NewPayloadType builds the HTTP request body from the payload of the
// "MethodBodyPrimitiveArrayUserValidate" endpoint of the
// "ServiceBodyPrimitiveArrayUserValidate" service.
func NewPayloadType(p []*servicebodyprimitivearrayuservalidate.PayloadType) []*PayloadType {
	body := make([]*PayloadType, len(p))
	for i, val := range p {
		if val == nil {
			body[i] = nil
			continue
		}
		body[i] = marshalPayloadTypeToPayloadType2(val)
	}
	return body
}
