			}
			var (
				sessionID          string
				sessionIDRaw       string
				sessionIDExpiresIn int

				cookies = resp.Cookies()
			)
			for _, c := range cookies {
				switch c.Name {
				case "SID":
					sessionIDRaw = c.Value
