// NewMethodBodyUnionUnion builds a ServiceBodyUnion service MethodBodyUnion
// endpoint payload.
func NewMethodBodyUnionUnion(body *MethodBodyUnionRequestBody) *servicebodyunion.Union {
	v := &servicebodyunion.Union{}
	if body.Values != nil && body.Values.Kind() != "" {
		var valuesValue servicebodyunion.Values
		switch string(body.Values.Kind()) {
		case "String":
			actual, _ := body.Values.AsString()
			obj := servicebodyunion.ValuesString(actual)

			u := valuesValue
			u.SetString((servicebodyunion.ValuesString)(obj))
			valuesValue = u
		case "Int":
			actual, _ := body.Values.AsInt()
			obj := servicebodyunion.ValuesInt(actual)

			u := valuesValue
			u.SetInt((servicebodyunion.ValuesInt)(obj))
			valuesValue = u
		}
		v.Values = &valuesValue
	}

	return v
}
