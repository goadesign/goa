// DecodeShowRequest returns a decoder for requests sent to the
// NestedTopLevelConstructorUnionCustomKeys Show endpoint.
func DecodeShowRequest(mux goahttp.Muxer, decoder func(*http.Request) goahttp.Decoder) func(*http.Request) (*nestedtoplevelconstructorunioncustomkeys.OuterAOrOuterB, error) {
	return func(r *http.Request) (*nestedtoplevelconstructorunioncustomkeys.OuterAOrOuterB, error) {
		var payload *nestedtoplevelconstructorunioncustomkeys.OuterAOrOuterB
		var (
			body *OuterAOrOuterB
			err  error
		)
		err = decoder(r).Decode(&body)
		if err != nil {
			if errors.Is(err, io.EOF) {
				return payload, goa.MissingPayloadError()
			}
			var gerr *goa.ServiceError
			if errors.As(err, &gerr) {
				return payload, gerr
			}
			return payload, goa.DecodePayloadError(err.Error())
		}
		if body == nil {
			return payload, goa.MissingPayloadError()
		}
		if body != nil {
			switch string(body.Kind()) {
			case "OuterA":
				actual, _ := body.AsOuterA()
				if actual == nil {
					err = goa.MergeErrors(err, goa.MissingFieldError("value", "body.value"))
					break
				}
				if actual != nil {
					if err2 := ValidateOuterA(actual); err2 != nil {
						err = goa.MergeErrors(err, err2)
					}
				}
			case "OuterB":
				actual, _ := body.AsOuterB()
				if actual == nil {
					err = goa.MergeErrors(err, goa.MissingFieldError("value", "body.value"))
					break
				}
				if actual != nil {
					if err2 := ValidateOuterB(actual); err2 != nil {
						err = goa.MergeErrors(err, err2)
					}
				}
			}

			if err != nil {
				return payload, err
			}
		}
		payload = NewShowOuterAOrOuterB(&body)

		return payload, nil
	}
}
