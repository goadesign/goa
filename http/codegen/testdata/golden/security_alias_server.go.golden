// endpoint payload.
func NewBasicOptionalPayload(username *string, password *string) *namedsecuritytypes.BasicOptionalPayload {
	v := &namedsecuritytypes.BasicOptionalPayload{}
	if username != nil {
		tmpusername := namedsecuritytypes.Credential(*username)
		v.Username = &tmpusername
	}
	if password != nil {
		tmppassword := namedsecuritytypes.Credential(*password)
		v.Password = &tmppassword
	}

	return v
}

