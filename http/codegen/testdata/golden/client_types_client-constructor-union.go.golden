// TextPayload is used to define fields on request body types.
type TextPayload struct {
	Text string `form:"text" json:"text" xml:"text"`
}

// JSONPayload is used to define fields on request body types.
type JSONPayload struct {
	Message string `form:"message" json:"message" xml:"message"`
}

// JSONPayloadOrTextPayload is a sum-type union.
type JSONPayloadOrTextPayload struct {
	kind        JSONPayloadOrTextPayloadKind
	TextPayload *TextPayload
	JSONPayload *JSONPayload
}

// JSONPayloadOrTextPayloadKind enumerates the union variants for JSONPayloadOrTextPayload.
type JSONPayloadOrTextPayloadKind string

const (
	// JSONPayloadOrTextPayloadKindTextPayload identifies the TextPayload branch of the union.
	JSONPayloadOrTextPayloadKindTextPayload JSONPayloadOrTextPayloadKind = "TextPayload"
	// JSONPayloadOrTextPayloadKindJSONPayload identifies the JSONPayload branch of the union.
	JSONPayloadOrTextPayloadKindJSONPayload JSONPayloadOrTextPayloadKind = "JSONPayload"
)

// Kind returns the discriminator value of the union.
func (u JSONPayloadOrTextPayload) Kind() JSONPayloadOrTextPayloadKind {
	return u.kind
}

// NewJSONPayloadOrTextPayloadTextPayload constructs a JSONPayloadOrTextPayload with the TextPayload branch set.
func NewJSONPayloadOrTextPayloadTextPayload(v *TextPayload) JSONPayloadOrTextPayload {
	return JSONPayloadOrTextPayload{
		kind:        JSONPayloadOrTextPayloadKindTextPayload,
		TextPayload: v,
	}
}

// AsTextPayload returns the value of the TextPayload branch if set.
func (u JSONPayloadOrTextPayload) AsTextPayload() (_ *TextPayload, ok bool) {
	if u.kind != JSONPayloadOrTextPayloadKindTextPayload {
		return
	}
	return u.TextPayload, true
}

// SetTextPayload sets the TextPayload branch of the union.
func (u *JSONPayloadOrTextPayload) SetTextPayload(v *TextPayload) {
	u.kind = JSONPayloadOrTextPayloadKindTextPayload
	u.TextPayload = v
}

// NewJSONPayloadOrTextPayloadJSONPayload constructs a JSONPayloadOrTextPayload with the JSONPayload branch set.
func NewJSONPayloadOrTextPayloadJSONPayload(v *JSONPayload) JSONPayloadOrTextPayload {
	return JSONPayloadOrTextPayload{
		kind:        JSONPayloadOrTextPayloadKindJSONPayload,
		JSONPayload: v,
	}
}

// AsJSONPayload returns the value of the JSONPayload branch if set.
func (u JSONPayloadOrTextPayload) AsJSONPayload() (_ *JSONPayload, ok bool) {
	if u.kind != JSONPayloadOrTextPayloadKindJSONPayload {
		return
	}
	return u.JSONPayload, true
}

// SetJSONPayload sets the JSONPayload branch of the union.
func (u *JSONPayloadOrTextPayload) SetJSONPayload(v *JSONPayload) {
	u.kind = JSONPayloadOrTextPayloadKindJSONPayload
	u.JSONPayload = v
}

// Validate ensures the union discriminant is valid.
func (u JSONPayloadOrTextPayload) Validate() error {
	switch u.kind {
	case "":
		return goa.InvalidEnumValueError("type", "", []any{
			string(JSONPayloadOrTextPayloadKindTextPayload),
			string(JSONPayloadOrTextPayloadKindJSONPayload),
		})
	case JSONPayloadOrTextPayloadKindTextPayload:
		return nil
	case JSONPayloadOrTextPayloadKindJSONPayload:
		return nil
	default:
		return goa.InvalidEnumValueError("type", u.kind, []any{
			string(JSONPayloadOrTextPayloadKindTextPayload),
			string(JSONPayloadOrTextPayloadKindJSONPayload),
		})
	}
}

// MarshalJSON marshals the union into the canonical {type,value} JSON shape.
func (u JSONPayloadOrTextPayload) MarshalJSON() ([]byte, error) {
	if err := u.Validate(); err != nil {
		return nil, err
	}
	var (
		value any
	)
	switch u.kind {
	case JSONPayloadOrTextPayloadKindTextPayload:
		value = u.TextPayload
	case JSONPayloadOrTextPayloadKindJSONPayload:
		value = u.JSONPayload
	default:
		return nil, fmt.Errorf("unexpected JSONPayloadOrTextPayload discriminant %q", u.kind)
	}
	return json.Marshal(struct {
		Type  string `json:"type"`
		Value any    `json:"value"`
	}{
		Type:  string(u.kind),
		Value: value,
	})
}

// UnmarshalJSON unmarshals the union from the canonical {type,value} JSON shape.
func (u *JSONPayloadOrTextPayload) UnmarshalJSON(data []byte) error {
	var raw struct {
		Type  string          `json:"type"`
		Value json.RawMessage `json:"value"`
	}
	if err := json.Unmarshal(data, &raw); err != nil {
		return err
	}
	switch raw.Type {
	case string(JSONPayloadOrTextPayloadKindTextPayload):
		var v *TextPayload
		if err := json.Unmarshal(raw.Value, &v); err != nil {
			return err
		}
		u.kind = JSONPayloadOrTextPayloadKindTextPayload
		u.TextPayload = v
	case string(JSONPayloadOrTextPayloadKindJSONPayload):
		var v *JSONPayload
		if err := json.Unmarshal(raw.Value, &v); err != nil {
			return err
		}
		u.kind = JSONPayloadOrTextPayloadKindJSONPayload
		u.JSONPayload = v
	default:
		return fmt.Errorf("unexpected JSONPayloadOrTextPayload type %q", raw.Type)
	}
	return nil
}

