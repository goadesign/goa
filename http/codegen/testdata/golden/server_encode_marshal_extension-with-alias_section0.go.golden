// unmarshalExtensionToFooserviceExtension builds a value of type
// *fooservice.Extension from a value of type *Extension.
func unmarshalExtensionToFooserviceExtension(v *Extension) *fooservice.Extension {
	if v == nil {
		return nil
	}
	res := &fooservice.Extension{}
	if v.Bar != nil {
		res.Bar = unmarshalBarToFooserviceBar(v.Bar)
	}

	return res
}
