// DecodeMethodARequest returns a decoder for requests sent to the
// ServiceQueryArrayAliasValidate MethodA endpoint.
func DecodeMethodARequest(mux goahttp.Muxer, decoder func(*http.Request) goahttp.Decoder) func(*http.Request) (*servicequeryarrayaliasvalidate.MethodAPayload, error) {
	return func(r *http.Request) (*servicequeryarrayaliasvalidate.MethodAPayload, error) {
		var (
			array []float64
			err   error
		)
		{
			arrayRaw := r.URL.Query()["array"]
			if arrayRaw != nil {
				array = make([]float64, len(arrayRaw))
				for i, rv := range arrayRaw {
					v, err2 := strconv.ParseFloat(rv, 64)
					if err2 != nil {
						err = goa.MergeErrors(err, goa.InvalidFieldTypeError("array", arrayRaw, "array of floats"))
					}
					array[i] = v
				}
			}
		}
		for _, e := range array {
			if e < 10 {
				err = goa.MergeErrors(err, goa.InvalidRangeError("array[*]", e, 10, true))
			}
		}
		if err != nil {
			return nil, err
		}
		payload := NewMethodAPayload(array)

		return payload, nil
	}
}
