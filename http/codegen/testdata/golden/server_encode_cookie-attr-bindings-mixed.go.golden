// EncodeMethodCookieAttrBindingsMixedResponse returns an encoder for responses
// returned by the ServiceCookieAttrBindingsMixed MethodCookieAttrBindingsMixed
// endpoint.
func EncodeMethodCookieAttrBindingsMixedResponse(encoder func(context.Context, http.ResponseWriter) goahttp.Encoder) func(context.Context, http.ResponseWriter, any) error {
	return func(ctx context.Context, w http.ResponseWriter, v any) error {
		res, _ := v.(*servicecookieattrbindingsmixed.MethodCookieAttrBindingsMixedResult)
		enc := encoder(ctx, w)
		body := NewMethodCookieAttrBindingsMixedResponseBody(res)
		a := res.A
		cookiea := &http.Cookie{
			Name:   "A",
			Value:  a,
			MaxAge: int(res.ExpiresIn),
			Domain: "goa.design",
			Secure: true,
		}
		http.SetCookie(w, cookiea)
		b := res.B
		http.SetCookie(w, &http.Cookie{
			Name:   "B",
			Value:  b,
			MaxAge: 3600,
			Domain: "goa.design",
			Secure: true,
		})
		w.WriteHeader(http.StatusOK)
		return enc.Encode(body)
	}
}
