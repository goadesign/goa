				return nil, goahttp.ErrValidationError("ServiceCookieAttrBindingsMixed", "MethodCookieAttrBindingsMixed", err)
			}
			res := NewMethodCookieAttrBindingsMixedResultOK(&body, a, b)
			res.ExpiresIn = aExpiresIn
			return res, nil
