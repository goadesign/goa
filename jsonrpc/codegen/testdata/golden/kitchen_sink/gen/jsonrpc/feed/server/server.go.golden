	rb.statusCode = statusCode
}

func (rb *batchWriter) Write(data []byte) (int, error) {
	separator := byte(',')
	if !rb.written {
		separator = '['
	}
	if _, err := rb.Writer.Write([]byte{separator}); err != nil {
		return 0, err
	}
	rb.written = true
	return rb.Writer.Write(data)
}

