			sseServerStream: sseServerStream{
				w:       w,
				encoder: encoder,
			},
		}
		decodeParams := DecodeWatchRequest(mux, decoder)
		params, err := decodeParams(r, req)
		if err != nil {
			if req.HasID {
				return strm.sendError(ctx, req.ID, jsonrpc.InvalidParams, err.Error(), nil)
			}
			return nil
		}
		if req.ID != nil {
			params.RequestID = jsonrpc.IDToString(req.ID)
		}
