	fmt.Fprintln(os.Stderr, "COMMAND:")
	fmt.Fprintln(os.Stderr, `    add: Add implements add.`)
	fmt.Fprintln(os.Stderr, `    ping: Ping implements ping.`)
	fmt.Fprintln(os.Stderr, `    log: Log implements log.`)
	fmt.Fprintln(os.Stderr)
	fmt.Fprintln(os.Stderr, "Additional help:")
	fmt.Fprintf(os.Stderr, "    %s calc COMMAND --help\n", os.Args[0])
}
