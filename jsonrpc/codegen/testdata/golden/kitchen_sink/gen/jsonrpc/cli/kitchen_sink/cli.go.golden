}

// UsageExamples produces an example of a valid invocation of the CLI tool.
func UsageExamples() string {
	return os.Args[0] + " " + "calc add --body '{\n      \"a\": 281524111196350841,\n      \"b\": 4865202500627059760,\n      \"id\": \"Perspiciatis sed soluta distinctio facere voluptas et.\"\n   }'" + "\n" +
		os.Args[0] + " " + "chat echo --body '{\n      \"id\": \"Nemo consequuntur est odio.\",\n      \"msg\": \"Accusantium mollitia id sapiente ratione.\"\n   }'" + "\n" +
		os.Args[0] + " " + "feed watch --body '{\n      \"last_event_id\": \"Iure dolor.\",\n      \"request_id\": \"Aut voluptas.\"\n   }'" + "\n" +
		os.Args[0] + " " + "mixed lookup --body '{\n      \"id\": \"Mollitia voluptatum expedita velit assumenda.\",\n      \"key\": \"Blanditiis sed voluptatum odit dolores impedit.\"\n   }'" + "\n" +
		""
}

