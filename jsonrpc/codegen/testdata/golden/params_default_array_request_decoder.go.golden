// DecodeDefaultArrayRequest returns a decoder for requests sent to the
// defaults default_array endpoint.
func DecodeDefaultArrayRequest(mux goahttp.Muxer, decoder func(*http.Request) goahttp.Decoder) func(*http.Request, *jsonrpc.RawRequest) (*defaults.DefaultArrayPayload, error) {
	return func(r *http.Request, req *jsonrpc.RawRequest) (*defaults.DefaultArrayPayload, error) {
		r.Body = io.NopCloser(bytes.NewReader(req.Params))
		var payload *defaults.DefaultArrayPayload
		var (
			body []string
			err  error
		)
		err = decoder(r).Decode(&body)
		if err != nil {
			if errors.Is(err, io.EOF) {
				err = nil
			} else {
				var gerr *goa.ServiceError
				if errors.As(err, &gerr) {
					return payload, gerr
				}
				return payload, goa.DecodePayloadError(err.Error())
			}
		}
		payload = NewDefaultArrayPayload(body)

		return payload, nil
	}
}
