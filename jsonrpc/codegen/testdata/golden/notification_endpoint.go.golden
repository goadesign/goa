package client

// WithPayload returns an endpoint that sends JSON-RPC notifications to the
// notifications service with_payload method.
func (c *Client) WithPayload() goa.Endpoint {
	var (
		encodeRequest = EncodeWithPayloadRequest(c.encoder)
	)
	return func(ctx context.Context, v any) (any, error) {
		req, err := c.BuildWithPayloadRequest(ctx, v)
		if err != nil {
			return nil, err
		}
		if err := encodeRequest(req, v); err != nil {
			return nil, err
		}
		resp, err := c.Doer.Do(req)
		if err != nil {
			return nil, goahttp.ErrRequestError("notifications", "with_payload", err)
		}
		if resp.StatusCode < http.StatusOK || resp.StatusCode >= http.StatusMultipleChoices {
			body, readErr := io.ReadAll(resp.Body)
			closeErr := resp.Body.Close()
			if err := errors.Join(readErr, closeErr); err != nil {
				return nil, goahttp.ErrDecodingError("notifications", "with_payload", err)
			}
			return nil, goahttp.ErrInvalidResponse("notifications", "with_payload", resp.StatusCode, string(body))
		}
		if err := resp.Body.Close(); err != nil {
			return nil, goahttp.ErrDecodingError("notifications", "with_payload", err)
		}
		return nil, nil
	}
}

