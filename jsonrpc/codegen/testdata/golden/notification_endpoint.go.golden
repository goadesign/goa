// notifications service ordinary_void method.
func (c *Client) OrdinaryVoid() goa.Endpoint {
	var (
		encodeRequest  = EncodeOrdinaryVoidRequest(c.encoder)
		decodeResponse = DecodeOrdinaryVoidResponse(c.decoder, c.RestoreResponseBody)
	)
	return func(ctx context.Context, v any) (any, error) {
		req, err := c.BuildOrdinaryVoidRequest(ctx, v)
		if err != nil {
			return nil, err
		}
		requestID, err := encodeRequest(req, v)
		if err != nil {
			return nil, err
		}
		resp, err := c.Doer.Do(req)
		if err != nil {
			return nil, goahttp.ErrRequestError("notifications", "ordinary_void", err)
		}
		return decodeResponse(resp, requestID)
	}
}

