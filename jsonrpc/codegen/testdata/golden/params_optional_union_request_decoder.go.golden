// DecodeOptionalUnionRequest returns a decoder for requests sent to the params
// optional_union endpoint.
func DecodeOptionalUnionRequest(mux goahttp.Muxer, decoder func(*http.Request) goahttp.Decoder) func(*http.Request, *jsonrpc.RawRequest) (*params.OptionalUnionPayload, error) {
	return func(r *http.Request, req *jsonrpc.RawRequest) (*params.OptionalUnionPayload, error) {
		r.Body = io.NopCloser(bytes.NewReader(req.Params))
		var payload *params.OptionalUnionPayload
		var (
			body *OptionalRequestValueRequestBody
			err  error
		)
		err = decoder(r).Decode(&body)
		if err != nil {
			if errors.Is(err, io.EOF) {
				err = nil
			} else {
				var gerr *goa.ServiceError
				if errors.As(err, &gerr) {
					return payload, gerr
				}
				return payload, goa.DecodePayloadError(err.Error())
			}
		}
		payload = NewOptionalUnionPayload(body)

		return payload, nil
	}
}
