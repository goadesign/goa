

// wrapMethodLogging applies the logging server interceptor to endpoints.
func wrapMethodLogging(endpoint goa.Endpoint, i ServerInterceptors) goa.Endpoint {
	return func(ctx context.Context, req any) (any, error) {
		info := &loggingMethodServerUnaryInfo{
			loggingMethodInfo: &loggingMethodInfo{rawPayload: req},
		}
		return i.Logging(ctx, info, endpoint)
	}
}

