

// wrapClientTracingMethod applies the tracing client interceptor to endpoints.
func wrapClientMethodTracing(endpoint goa.InterceptorEndpoint, i ClientInterceptors) goa.InterceptorEndpoint {
	return func(ctx context.Context, req any) (any, context.Context, error) {
		info := &TracingInfo{
			service:  "SingleClientInterceptor",
			method:   "Method",
			callType: goa.InterceptorUnary,
			payload:  req,
		}
		return i.Tracing(ctx, info, endpoint)
	}
}
