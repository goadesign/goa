

// wrapLoggingMethod applies the logging server interceptor to endpoints.
func wrapMethodLogging(endpoint goa.InterceptorEndpoint, i ServerInterceptors) goa.InterceptorEndpoint {
	return func(ctx context.Context, req any) (any, context.Context, error) {
		info := &LoggingInfo{
			service:    "StreamingInterceptorsWithReadResult",
			method:     "Method",
			callType:   goa.InterceptorUnary,
			rawPayload: req,
		}
		return i.Logging(ctx, info, endpoint)
	}
}
