	return func(ctx context.Context, req any) (any, error) {
		info := &CachingInfo{
			Service:    "InterceptorWithReadResult",
			Method:     method,
			Endpoint:   endpoint,
			RawPayload: req,
		}
		return i.Caching(ctx, info, endpoint)
	}
}
