

// wrapMethodTest applies the test server interceptor to endpoints.
func wrapMethodTest(endpoint goa.Endpoint, i ServerInterceptors) goa.Endpoint {
	return func(ctx context.Context, req any) (any, error) {
		info := &testMethodServerUnaryInfo{
			testMethodInfo: &testMethodInfo{rawPayload: req},
		}
		return i.Test(ctx, info, endpoint)
	}
}

