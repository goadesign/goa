

// wrapTestMethod applies the test server interceptor to endpoints.
func wrapMethodTest(endpoint goa.InterceptorEndpoint, i ServerInterceptors) goa.InterceptorEndpoint {
	return func(ctx context.Context, req any) (any, context.Context, error) {
		info := &TestInfo{
			service:    "MultipleInterceptorsService",
			method:     "Method",
			callType:   goa.InterceptorUnary,
			rawPayload: req,
		}
		return i.Test(ctx, info, endpoint)
	}
}

