
// Service is the UnionService service interface.
type Service interface {
	// A implements A.
	A(context.Context, *AUnion) (res *AUnion, err error)
}

// APIName is the name of the API as defined in the design.
const APIName = "test api"

// APIVersion is the version of the API as defined in the design.
const APIVersion = "0.0.1"

// ServiceName is the name of the service as defined in the design. This is the
// same value that is set in the endpoint request contexts under the ServiceKey
// key.
const ServiceName = "UnionService"

// MethodNames lists the service method names as defined in the design. These
// are the same values that are set in the endpoint request contexts under the
// MethodKey key.
var MethodNames = [1]string{"A"}

// AUnion is the payload type of the UnionService service A method.
type AUnion struct {
	Values Values
}

type ValuesBoolean bool

type ValuesBytes []byte

type ValuesInt int

type ValuesString string

// Values holds exactly one of its branch values.
type Values struct {
	kind    ValuesKind
	Int     ValuesInt
	String  ValuesString
	Boolean ValuesBoolean
	Bytes   ValuesBytes
}

// ValuesKind records which Values branch is selected.
type ValuesKind string

const (
	// ValuesKindInt identifies the Int branch.
	ValuesKindInt ValuesKind = "Int"
	// ValuesKindString identifies the String branch.
	ValuesKindString ValuesKind = "String"
	// ValuesKindBoolean identifies the Boolean branch.
	ValuesKindBoolean ValuesKind = "Boolean"
	// ValuesKindBytes identifies the Bytes branch.
	ValuesKindBytes ValuesKind = "Bytes"
)

// Kind returns the selected branch.
func (u Values) Kind() ValuesKind {
	return u.kind
}

// NewValuesInt constructs Values with the Int branch set.
func NewValuesInt(v ValuesInt) Values {
	return Values{
		kind: ValuesKindInt,
		Int:  v,
	}
}

// AsInt returns the value when the Int branch is selected.
func (u Values) AsInt() (_ ValuesInt, ok bool) {
	if u.kind != ValuesKindInt {
		return
	}
	return u.Int, true
}

// SetInt selects the Int branch and stores v.
func (u *Values) SetInt(v ValuesInt) {
	u.kind = ValuesKindInt
	u.Int = v
}

// NewValuesString constructs Values with the String branch set.
func NewValuesString(v ValuesString) Values {
	return Values{
		kind:   ValuesKindString,
		String: v,
	}
}

// AsString returns the value when the String branch is selected.
func (u Values) AsString() (_ ValuesString, ok bool) {
	if u.kind != ValuesKindString {
		return
	}
	return u.String, true
}

// SetString selects the String branch and stores v.
func (u *Values) SetString(v ValuesString) {
	u.kind = ValuesKindString
	u.String = v
}

// NewValuesBoolean constructs Values with the Boolean branch set.
func NewValuesBoolean(v ValuesBoolean) Values {
	return Values{
		kind:    ValuesKindBoolean,
		Boolean: v,
	}
}

// AsBoolean returns the value when the Boolean branch is selected.
func (u Values) AsBoolean() (_ ValuesBoolean, ok bool) {
	if u.kind != ValuesKindBoolean {
		return
	}
	return u.Boolean, true
}

// SetBoolean selects the Boolean branch and stores v.
func (u *Values) SetBoolean(v ValuesBoolean) {
	u.kind = ValuesKindBoolean
	u.Boolean = v
}

// NewValuesBytes constructs Values with the Bytes branch set.
func NewValuesBytes(v ValuesBytes) Values {
	return Values{
		kind:  ValuesKindBytes,
		Bytes: v,
	}
}

// AsBytes returns the value when the Bytes branch is selected.
func (u Values) AsBytes() (_ ValuesBytes, ok bool) {
	if u.kind != ValuesKindBytes {
		return
	}
	return u.Bytes, true
}

// SetBytes selects the Bytes branch and stores v.
func (u *Values) SetBytes(v ValuesBytes) {
	u.kind = ValuesKindBytes
	u.Bytes = v
}

// Validate ensures exactly one valid branch is selected.
func (u Values) Validate() error {
	switch u.kind {
	case "":
		return goa.InvalidEnumValueError("type", "", []any{
			string(ValuesKindInt),
			string(ValuesKindString),
			string(ValuesKindBoolean),
			string(ValuesKindBytes),
		})
	case ValuesKindInt:
		return nil
	case ValuesKindString:
		return nil
	case ValuesKindBoolean:
		return nil
	case ValuesKindBytes:
		if u.Bytes == nil {
			return goa.MissingFieldError("value", "Values")
		}
		return nil
	default:
		return goa.InvalidEnumValueError("type", u.kind, []any{
			string(ValuesKindInt),
			string(ValuesKindString),
			string(ValuesKindBoolean),
			string(ValuesKindBytes),
		})
	}
}

// MarshalJSON marshals the union into the canonical {type,value} JSON shape.
func (u Values) MarshalJSON() ([]byte, error) {
	if err := u.Validate(); err != nil {
		return nil, err
	}
	var (
		value any
	)
	switch u.kind {
	case ValuesKindInt:
		value = u.Int
	case ValuesKindString:
		value = u.String
	case ValuesKindBoolean:
		value = u.Boolean
	case ValuesKindBytes:
		value = u.Bytes
	default:
		return nil, fmt.Errorf("unexpected Values kind %q", u.kind)
	}
	return json.Marshal(struct {
		Type  string `json:"type"`
		Value any    `json:"value"`
	}{
		Type:  string(u.kind),
		Value: value,
	})
}

// UnmarshalJSON unmarshals the union from the canonical {type,value} JSON shape.
func (u *Values) UnmarshalJSON(data []byte) error {
	var raw struct {
		Type  string          `json:"type"`
		Value json.RawMessage `json:"value"`
	}
	if err := json.Unmarshal(data, &raw); err != nil {
		return err
	}
	if len(raw.Value) == 0 {
		return goa.MissingFieldError("value", "Values")
	}
	if bytes.Equal(bytes.TrimSpace(raw.Value), []byte("null")) {
		return goa.InvalidFieldTypeError("value", nil, "non-null JSON value")
	}
	switch raw.Type {
	case string(ValuesKindInt):
		var v ValuesInt
		if err := json.Unmarshal(raw.Value, &v); err != nil {
			return err
		}
		u.kind = ValuesKindInt
		u.Int = v
	case string(ValuesKindString):
		var v ValuesString
		if err := json.Unmarshal(raw.Value, &v); err != nil {
			return err
		}
		u.kind = ValuesKindString
		u.String = v
	case string(ValuesKindBoolean):
		var v ValuesBoolean
		if err := json.Unmarshal(raw.Value, &v); err != nil {
			return err
		}
		u.kind = ValuesKindBoolean
		u.Boolean = v
	case string(ValuesKindBytes):
		var v ValuesBytes
		if err := json.Unmarshal(raw.Value, &v); err != nil {
			return err
		}
		u.kind = ValuesKindBytes
		u.Bytes = v
	default:
		if raw.Type == "" {
			return goa.MissingFieldError("type", "Values")
		}
		return goa.InvalidEnumValueError("type", raw.Type, []any{
			string(ValuesKindInt),
			string(ValuesKindString),
			string(ValuesKindBoolean),
			string(ValuesKindBytes),
		})
	}
	return nil
}
