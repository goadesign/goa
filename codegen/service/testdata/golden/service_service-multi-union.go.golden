
// Service is the MultiUnionService service interface.
type Service interface {
	// MultiUnion implements MultiUnion.
	MultiUnion(context.Context, *Union) (res *Union, err error)
}

// APIName is the name of the API as defined in the design.
const APIName = "test api"

// APIVersion is the version of the API as defined in the design.
const APIVersion = "0.0.1"

// ServiceName is the name of the service as defined in the design. This is the
// same value that is set in the endpoint request contexts under the ServiceKey
// key.
const ServiceName = "MultiUnionService"

// MethodNames lists the service method names as defined in the design. These
// are the same values that are set in the endpoint request contexts under the
// MethodKey key.
var MethodNames = [1]string{"MultiUnion"}

type TypeA struct {
	A *int
}

type TypeB struct {
	B *string
}

// Union is the payload type of the MultiUnionService service MultiUnion method.
type Union struct {
	Values Values
}

// Values holds exactly one of its branch values.
type Values struct {
	kind ValuesKind
	a    *TypeA
	b    *TypeB
}

// ValuesKind records which Values branch is selected.
type ValuesKind string

const (
	// ValuesKindA identifies the a branch.
	ValuesKindA ValuesKind = "a"
	// ValuesKindB identifies the b branch.
	ValuesKindB ValuesKind = "b"
)

// Kind returns the selected branch.
func (u Values) Kind() ValuesKind {
	return u.kind
}

// NewValuesA constructs Values with the a branch set.
func NewValuesA(v *TypeA) Values {
	return Values{
		kind: ValuesKindA,
		a:    v,
	}
}

// AsA returns the value when the a branch is selected.
func (u Values) AsA() (_ *TypeA, ok bool) {
	if u.kind != ValuesKindA {
		return
	}
	return u.a, true
}

// SetA selects the a branch and stores v.
func (u *Values) SetA(v *TypeA) {
	*u = Values{
		kind: ValuesKindA,
		a:    v,
	}
}

// NewValuesB constructs Values with the b branch set.
func NewValuesB(v *TypeB) Values {
	return Values{
		kind: ValuesKindB,
		b:    v,
	}
}

// AsB returns the value when the b branch is selected.
func (u Values) AsB() (_ *TypeB, ok bool) {
	if u.kind != ValuesKindB {
		return
	}
	return u.b, true
}

// SetB selects the b branch and stores v.
func (u *Values) SetB(v *TypeB) {
	*u = Values{
		kind: ValuesKindB,
		b:    v,
	}
}

// Validate ensures exactly one valid branch is selected.
func (u Values) Validate() error {
	switch u.kind {
	case "":
		return goa.InvalidEnumValueError("type", "", []any{
			string(ValuesKindA),
			string(ValuesKindB),
		})
	case ValuesKindA:
		if u.a == nil {
			return goa.MissingFieldError("value", "Values")
		}
		return nil
	case ValuesKindB:
		if u.b == nil {
			return goa.MissingFieldError("value", "Values")
		}
		return nil
	default:
		return goa.InvalidEnumValueError("type", u.kind, []any{
			string(ValuesKindA),
			string(ValuesKindB),
		})
	}
}

// MarshalJSON marshals the union into the canonical {type,value} JSON shape.
func (u Values) MarshalJSON() ([]byte, error) {
	if err := u.Validate(); err != nil {
		return nil, err
	}
	var (
		value any
	)
	switch u.kind {
	case ValuesKindA:
		value = u.a
	case ValuesKindB:
		value = u.b
	default:
		return nil, fmt.Errorf("unexpected Values kind %q", u.kind)
	}
	return json.Marshal(struct {
		Type  string `json:"type"`
		Value any    `json:"value"`
	}{
		Type:  string(u.kind),
		Value: value,
	})
}

// UnmarshalJSON unmarshals the union from the canonical {type,value} JSON shape.
func (u *Values) UnmarshalJSON(data []byte) error {
	var raw struct {
		Type  string          `json:"type"`
		Value json.RawMessage `json:"value"`
	}
	if err := json.Unmarshal(data, &raw); err != nil {
		return err
	}
	if len(raw.Value) == 0 {
		return goa.MissingFieldError("value", "Values")
	}
	if bytes.Equal(bytes.TrimSpace(raw.Value), []byte("null")) {
		return goa.InvalidFieldTypeError("value", nil, "non-null JSON value")
	}
	switch raw.Type {
	case string(ValuesKindA):
		var v *TypeA
		if err := json.Unmarshal(raw.Value, &v); err != nil {
			return err
		}
		u.SetA(v)
	case string(ValuesKindB):
		var v *TypeB
		if err := json.Unmarshal(raw.Value, &v); err != nil {
			return err
		}
		u.SetB(v)
	default:
		if raw.Type == "" {
			return goa.MissingFieldError("type", "Values")
		}
		return goa.InvalidEnumValueError("type", raw.Type, []any{
			string(ValuesKindA),
			string(ValuesKindB),
		})
	}
	return nil
}
