func transform() {
	target := &ArrayMap{}
	if source.ArrayMap != nil {
		target.ArrayMap = make(map[uint32][]float32, len(source.ArrayMap))
		for key, val := range source.ArrayMap {
			tk := key
			tv := make([]float32, len(val))
			for i, val := range val {
				tv[i] = float32(val)
			}
			target.ArrayMap[tk] = tv
		}
	}
}
