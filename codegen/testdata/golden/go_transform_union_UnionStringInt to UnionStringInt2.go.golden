func transform() {
	var target *UnionStringInt2

	if source != nil {
		switch string(source.Kind()) {
		case "String":
			actual, _ := source.AsString()
			obj := UnionStringInt2String(actual)

			var u UnionStringInt2
			u.SetString((UnionStringInt2String)(obj))
			target = &u
		case "Int":
			actual, _ := source.AsInt()
			obj := UnionStringInt2Int(actual)

			var u UnionStringInt2
			u.SetInt((UnionStringInt2Int)(obj))
			target = &u
		}
	}
}
