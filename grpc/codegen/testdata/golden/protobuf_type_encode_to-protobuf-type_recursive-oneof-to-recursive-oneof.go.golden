func transform() {
	target := &proto.RecursiveOneOf{
		String_: source.String,
	}
	if source.RecursiveOneOf.Kind() != "" {
		switch string(source.RecursiveOneOf.Kind()) {
		case "integer":
			actual, _ := source.RecursiveOneOf.AsInteger()
			target.RecursiveOneOf = &proto.RecursiveOneOf_Integer{Integer: int32(actual)}
		case "recurse":
			actual, _ := source.RecursiveOneOf.AsRecurse()
			target.RecursiveOneOf = &proto.RecursiveOneOf_Recurse{Recurse: svcProtoRecursiveOneOfToProtoRecursiveOneOf(actual)}
		}
	}
}
