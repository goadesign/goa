func transform() {
	target := &proto.SimpleOneOf{}
	if source.SimpleOneOf != nil {
		var simpleOneOfValue proto.SimpleOneOf2
		switch val := source.SimpleOneOf.(type) {
		case *proto.SimpleOneOf_String_:
			{
				u := simpleOneOfValue
				u.SetString(proto.SimpleOneOfString(val.String_))
				simpleOneOfValue = u
			}
		case *proto.SimpleOneOf_Integer:
			{
				u := simpleOneOfValue
				u.SetInteger(proto.SimpleOneOfInteger(val.Integer))
				simpleOneOfValue = u
			}
		}
		target.SimpleOneOf = &simpleOneOfValue
	}
}
