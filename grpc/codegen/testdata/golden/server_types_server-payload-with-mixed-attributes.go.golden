// ValidateUnaryMethodRequest runs the validations defined on
// UnaryMethodRequest.
func ValidateUnaryMethodRequest(message *service_payload_with_mixed_attributespb.UnaryMethodRequest) (err error) {
	if message.Required == nil {
		err = goa.MergeErrors(err, goa.MissingFieldError("required", "message"))
