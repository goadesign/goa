
syntax = "proto3";

package custom_message_name;

option go_package = "/custom_message_namepb";

// Service is the CustomMessageName service interface.
service CustomMessageName {
	// Unary implements Unary.
	rpc Unary (.custom_message_name.CustomType) returns (.custom_message_name.CustomType);
	// Stream implements Stream.
	rpc Stream (stream .custom_message_name.CustomType) returns (stream .custom_message_name.CustomType);
}

message CustomType {
	optional sint32 a = 1;
	optional string b = 2;
}
