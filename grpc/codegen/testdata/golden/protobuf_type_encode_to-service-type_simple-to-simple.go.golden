func transform() {
	target := &proto.Simple{
		RequiredString: *source.RequiredString,
	}
	if source.DefaultBool != nil {
		target.DefaultBool = *source.DefaultBool
	}
	if source.Integer != nil {
		integer := int(*source.Integer)
		target.Integer = &integer
	}
	if source.DefaultBool == nil {
		target.DefaultBool = true
	}
}
