func transform() {
	target := &proto.EmbeddedOneOf{
		String: source.String_,
	}
	if source.EmbeddedOneOf != nil {
		var embeddedOneOfValue proto.EmbeddedOneOf2
		switch val := source.EmbeddedOneOf.(type) {
		case *proto.EmbeddedOneOf_String_:
			{
				u := embeddedOneOfValue
				u.SetString(proto.EmbeddedOneOfString(val.String_))
				embeddedOneOfValue = u
			}
		case *proto.EmbeddedOneOf_Integer:
			{
				u := embeddedOneOfValue
				u.SetInteger(proto.EmbeddedOneOfInteger(val.Integer))
				embeddedOneOfValue = u
			}
		case *proto.EmbeddedOneOf_Boolean:
			{
				u := embeddedOneOfValue
				u.SetBoolean(proto.EmbeddedOneOfBoolean(val.Boolean))
				embeddedOneOfValue = u
			}
		case *proto.EmbeddedOneOf_Number:
			{
				u := embeddedOneOfValue
				u.SetNumber(proto.EmbeddedOneOfNumber(val.Number))
				embeddedOneOfValue = u
			}
		case *proto.EmbeddedOneOf_Array:
			{
				u := embeddedOneOfValue
				u.SetArray(protobufProtoEmbeddedOneOfArrayToProtoEmbeddedOneOfArray(val.Array))
				embeddedOneOfValue = u
			}
		case *proto.EmbeddedOneOf_Map_:
			{
				u := embeddedOneOfValue
				u.SetMap(protobufProtoEmbeddedOneOfMapToProtoEmbeddedOneOfMap(val.Map_))
				embeddedOneOfValue = u
			}
		case *proto.EmbeddedOneOf_UserType:
			{
				u := embeddedOneOfValue
				u.SetUserType(protobufProtoSimpleOneOfToProtoSimpleOneOf(val.UserType))
				embeddedOneOfValue = u
			}
		}
		target.EmbeddedOneOf = &embeddedOneOfValue
	}
}
